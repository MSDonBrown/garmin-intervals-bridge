# DO NOT commit actual credentials or Garmin session tokens.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
BRIDGE_DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/tokens
# your time zone, the day boundary (e.g. Europe/London); empty = this computer's, but a container has none
BRIDGE_TIMEZONE=
# sync windows (1-30 days); backfill takes explicit dates instead
BRIDGE_ACTIVITY_LOOKBACK_DAYS=4
BRIDGE_WELLNESS_LOOKBACK_DAYS=3
BRIDGE_WELLNESS_REFRESH_HOURS=4
# recommended (default) or all custom wellness fields, see docs/FIELD_MAPPING.md
BRIDGE_WELLNESS_PROFILE=recommended
# Seconds between Garmin requests; the endpoints are private, stay polite
BRIDGE_GARMIN_REQUEST_DELAY=0.5
# ImReady4 training advice into the TrainingAdvice wellness field each morning (docs/IMREADY4.md)
BRIDGE_IMREADY4_ENABLED=false
# experimental: advice from the 7-day HRV trend into its own field HRVTrendAdvice (docs/HRV_TREND.md)
BRIDGE_HRVTREND_ENABLED=false
# poll less (or more): seconds between polls (default 300), and only in these hours (e.g. 10-18; empty = always)
# BRIDGE_POLL_SECONDS=300
# BRIDGE_POLL_HOURS=10-18
# swap Garmin's filtered copy of each new activity for its original (deletes the copy; README: Modes)
BRIDGE_SWAP=false
# when the bridge needs you (Garmin sign-in, failing for a day): a push message (ntfy) and/or an e-mail
# BRIDGE_NTFY_URL=https://ntfy.sh/a-long-name-only-you-know
# BRIDGE_ALERT_EMAIL=you@gmail.com
# BRIDGE_SMTP_PASSWORD=app-password
# Timers and thresholds, each with the value the bridge always used (see tuning.py and the README,
# Timers and thresholds). Change one here; an empty value means the default.
# --- On-demand sync (`sync-now`)
# After an on-demand sync the next full run of `run` waits at least this long (0 = no hold-off) [minutes, 0-1440]
BRIDGE_ONDEMAND_SYNC_HOLDOFF_MINUTES=30
# After an on-demand sync the regular polls for new activities pause this long ("Check now" still works) [seconds, 0-86400]
BRIDGE_ONDEMAND_POLL_HOLDOFF_SECONDS=900
# A `sync-now` without a named activity or day, this soon after the last one, returns its result [seconds, 0-3600]
BRIDGE_ONDEMAND_MIN_GAP_SECONDS=60
# How long `sync-now` waits for a running sync (a cycle of `run`, a timer, a backfill) to let go of its part [seconds, 0-7200]
BRIDGE_ONDEMAND_LOCK_WAIT_SECONDS=600
# Longest a whole `sync-now` may take, waiting and retrying included (then it reports and stops) [seconds, 60-7200]
BRIDGE_ONDEMAND_MAX_SECONDS=900
# `sync-now --wait-new`: how often to look again when nothing new is there yet (the watch may still be syncing) [tries, 0-50]
BRIDGE_ONDEMAND_RETRIES=5
# `sync-now --wait-new`: pause between those looks [seconds, 10-3600]
BRIDGE_ONDEMAND_RETRY_SECONDS=120
# `sync-now` looks this many days back for activities (today included) [days, 1-30]
BRIDGE_ONDEMAND_ACTIVITY_DAYS=2
# `sync-now` reads wellness for this many days (today included), ignoring the refresh window [days, 1-30]
BRIDGE_ONDEMAND_WELLNESS_DAYS=2
# --- The run loop (`run`)
# Minutes between the full runs (`--sync-minutes` wins; backup mode uses `BRIDGE_BACKUP_HOURS`) [minutes, 5-1440]
BRIDGE_SYNC_MINUTES=30
# Enrich mode: the full run skips its Garmin activity scan while the last one is younger (0 = never skip) [minutes, 0-1440]
BRIDGE_ACTIVITY_SCAN_MINUTES=120
# How often the loop asks whether a poll or a full run is due [seconds, 5-3600]
BRIDGE_TICK_SECONDS=60
# A full run that left a part out because a backfill works on it comes back this soon [seconds, 30-3600]
BRIDGE_PART_BUSY_RETRY_SECONDS=300
# A backfill waits this long for a running sync to finish with its part [seconds, 0-86400]
BRIDGE_BUSY_WAIT_SECONDS=300
# Least pause after Intervals.icu answers 429 (longer if it asks for longer) [seconds, 60-86400]
BRIDGE_RATE_LIMIT_PAUSE_SECONDS=900
# Pause after Garmin blocks, rate-limits or wants a sign-in [seconds, 60-86400]
BRIDGE_BLOCK_PAUSE_SECONDS=900
# A failed full run is tried again after this, doubling with each failure up to the full-run interval [seconds, 30-3600]
BRIDGE_FAILURE_BACKOFF_SECONDS=300
# Hours between the health probes written to the log [hours, 1-168]
BRIDGE_HEALTH_HOURS=24
# The first health probe comes this long after the start [seconds, 0-86400]
BRIDGE_HEALTH_FIRST_SECONDS=300
# --- Polling (`watch`, adaptive mode)
# After a new activity: poll at the fast pace this long, a second one may follow [minutes, 0-1440]
BRIDGE_HOT_MINUTES=60
# "Check now" right after a look waits this long (no button hammering) [seconds, 0-3600]
BRIDGE_ASK_GAP_SECONDS=30
# A look this much earlier than its time still counts as due [seconds, 0-300]
BRIDGE_POLL_SLACK_SECONDS=15
# Adaptive mode, unusual hours, without `BRIDGE_POLL_QUIET_SECONDS`: the pace [seconds, 60-86400]
BRIDGE_POLL_QUIET_DEFAULT_SECONDS=1800
# Adaptive mode learns your usual activity hours from this many days [days, 7-365]
BRIDGE_ADAPTIVE_LEARN_DAYS=84
# ... the weight of an activity halves with this many days of age [days, 1-365]
BRIDGE_ADAPTIVE_HALF_LIFE_DAYS=28
# ... and it needs this many before it trusts what it learned (until then: the fast pace) [activities, 1-1000]
BRIDGE_ADAPTIVE_MIN_ACTIVITIES=15
# ... the hours that hold this share of your activity ends get the fast pace [share, 0.05-1.0]
BRIDGE_ADAPTIVE_FAST_SHARE=0.8
# ... up to this share the middle pace (must be above the fast share); the rest the quiet pace [share, 0.05-1.0]
BRIDGE_ADAPTIVE_MIDDLE_SHARE=0.97
# --- Activities and wellness
# Garmin attaches weather and gear to a fresh activity a little later: asked again within this many days [days, 0-30]
BRIDGE_ARCHIVE_SETTLE_DAYS=2
# Drinks and gear are logged after the ride: Garmin is asked for them again once, this long after the start [hours, 0-168]
BRIDGE_INTAKE_SETTLE_HOURS=12
# After a pause the scheduled runs look back to the last run, at most this far [days, 1-90]
BRIDGE_CATCH_UP_DAYS=14
# Per full run: failed activities that left the scan window and are retried by id [activities, 0-50]
BRIDGE_RETRIES_BY_ID=3
# A day with passing endpoint failures counts as final after this many reads (wellness and backup) [tries, 1-10]
BRIDGE_FINAL_TRIES=3
# The wellness pre-check of Intervals (costs no Garmin request) at most this often [minutes, 1-1440]
BRIDGE_WELLNESS_CHECK_MINUTES=10
# Official sleep seen this recently: wait for it instead of asking Garmin [days, 0-30]
BRIDGE_WELLNESS_SIGNAL_DAYS=2
# No night from Garmin for this long: the advice does not wait for one [days, 1-60]
BRIDGE_GARMIN_NIGHT_DAYS=7
# A past day is read at this hour the day after, synced or not [hour, 0-23]
BRIDGE_FINAL_ANYWAY_HOUR=20
# Training readiness: tries when Garmin has not computed it yet [tries, 0-10]
BRIDGE_READINESS_RETRIES=2
# Training readiness: minutes between those tries [minutes, 1-1440]
BRIDGE_READINESS_RETRY_MINUTES=30
# --- Health checks
# No look or full run for this long (at least) counts as "not running" [hours, 1-168]
BRIDGE_HEALTH_STALE_RUN_HOURS=3
# A Garmin endpoint with an error on each of the last this many days is reported [days, 1-30]
BRIDGE_HEALTH_ENDPOINT_ERROR_DAYS=3
# Dropout check: the days a field must have been there before [days, 3-60]
BRIDGE_HEALTH_DROPOUT_BASELINE_DAYS=7
# Dropout check: in at least this many of those [days, 1-60]
BRIDGE_HEALTH_DROPOUT_MIN_BASELINE=5
# Dropout check: missing on each of the latest this many days is reported [days, 1-14]
BRIDGE_HEALTH_DROPOUT_MISSING_DAYS=2
# --- Backup mode
# A day counts as final at this hour of the next day (the watch has synced) [hour, 0-23]
BRIDGE_BACKUP_FINAL_HOUR=12
# A day is read once more this many days after it, for a watch that synced late [days, 1-14]
BRIDGE_BACKUP_LATE_READ_DAYS=3
# Each backup run looks for new activities this many days back [days, 1-30]
BRIDGE_BACKUP_RECENT_ACTIVITY_DAYS=3
# Each backup run considers the wellness of this many past days [days, 1-30]
BRIDGE_BACKUP_RECENT_WELLNESS_DAYS=7
# The account data (profile, devices, zones ...) is archived this often [days, 1-90]
BRIDGE_BACKUP_ACCOUNT_DAYS=7
